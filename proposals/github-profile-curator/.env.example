# Copie para .env e ajuste antes de rodar em producao.
# Nunca commite o arquivo .env real.

PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Obrigatorio em producao: chave aleatoria de 32+ bytes usada para assinar sessoes e CSRF.
# Gere com: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# 1 quando estiver atras de HTTPS/proxy reverso (adiciona Secure no cookie).
SECURE_COOKIES=1

# 1 somente se o proxy reverso for confiavel (usa x-forwarded-for na auditoria).
TRUST_PROXY=0

# Caminho opcional do banco SQLite (padrao: data/cuco.db).
DB_PATH=

# 1 para criar dados de demonstracao (somente testes/demo).
SEED_DEMO=0
